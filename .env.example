# =================================================================
# AI Study Assistant - Environment Variables Configuration Template
# =================================================================
# Copy this file to .env and adjust the values before starting services.

# -----------------------------------------------------------------
# MySQL Database Configuration
# -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_secure_password_123
MYSQL_DATABASE=ai_study_assistant
MYSQL_USER=study_user
MYSQL_PASSWORD=study_secure_password_123
MYSQL_PORT=3307

# -----------------------------------------------------------------
# Security & Authentication (Spring Boot Backend)
# -----------------------------------------------------------------
# Secret key used for signing JWT tokens (HMAC-SHA256, at least 256 bits / 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_256_bits_long_for_security_1234567890

# -----------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------
# API Key for Google Gemini API integration (Used exclusively in Spring Boot backend)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
