# AI Study Assistant - Production Desktop Environment
# REST API base URL pointing to the backend Spring Boot server.
# WebSocket STOMP (SockJS) endpoint pointing to the backend /ws endpoint.
# Change localhost to your remote server IP or Domain (e.g., https://api.yourdomain.com/api/v1 and https://api.yourdomain.com/ws)
# before packaging the desktop installer.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws
